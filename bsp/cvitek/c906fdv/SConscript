# for module compiling
import os
import multiprocessing

Import('RTT_ROOT')

# Get the number of CPU cores
cpu_count = multiprocessing.cpu_count()
# Set the number of jobs
SetOption('num_jobs', cpu_count)

cwd = str(Dir('#'))
objs = []
list = os.listdir(cwd)

for d in list:
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(d, 'SConscript'))


def scons_import(path, variant):
    return SConscript(os.path.join(cwd, path) + "/SConscript", variant_dir=variant, duplicate=0)

objs.extend(scons_import('../cvi_boards', 'cvi_boards'))
objs.extend(scons_import('../cvi_chips', 'cvi_chips'))
objs.extend(scons_import('../drivers', 'drivers'))


Return('objs')
