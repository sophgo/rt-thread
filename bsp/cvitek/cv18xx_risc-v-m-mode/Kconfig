mainmenu "RT-Thread Project Configuration"

BSP_DIR := .

RTT_DIR := ../../..

PKGS_DIR := packages

source "$(RTT_DIR)/Kconfig"
osource "$PKGS_DIR/Kconfig"
rsource "board/Kconfig"
rsource "../drivers/Kconfig"

config BSP_USING_CV18XX
    bool
    select ARCH_RISCV64
    select ARCH_RISCV_FPU_D
    select ARCH_USING_RISCV_COMMON64
    select RT_USING_SYSTEM_WORKQUEUE
    select RT_USING_COMPONENTS_INIT
    select RT_USING_USER_MAIN
    select RT_USING_CACHE
    select RT_USING_DEVICE_OPS
    select RT_USING_HW_ATOMIC
    default y

config C906_PLIC_PHY_ADDR
    hex
    default 0x70000000

config IRQ_MAX_NR
    int
    default 101

config BSP_GPIO_IRQ_BASE
    int
    default 60

config BSP_SYS_GPIO_IRQ_BASE
    int
    default 70

config __STACKSIZE__
    int "stack size for interrupt"
    default 4096

config SOC_TYPE_CV180XB_QFN
    bool
    default n

config SOC_TYPE_CV181XC_QFN
    bool
    default n

config SOC_TYPE_CV181XH_BGA
    bool
    default n

config __CV180X__
    bool
    default n

config __CV181X__
    bool
    default n

choice
    prompt "Board Type"
    default BOARD_TYPE_MILKV_DUO256M

    config BOARD_TYPE_MILKV_DUO
        select SOC_TYPE_CV180XB_QFN
        select __CV180X__
        bool "milkv-duo"

    config BOARD_TYPE_MILKV_DUO_SPINOR
        select SOC_TYPE_CV180XB_QFN
        select __CV180X__
        bool "milkv-duo-spinor"

    config BOARD_TYPE_MILKV_DUO256M
        select SOC_TYPE_CV181XC_QFN
        select __CV181X__
        bool "milkv-duo256m"

    config BOARD_TYPE_MILKV_DUO256M_SPINOR
        select SOC_TYPE_CV181XC_QFN
        select __CV181X__
        bool "milkv-duo256m-spinor"

    config BOARD_TYPE_MILKV_DUOS
        select SOC_TYPE_CV181XH_BGA
        select __CV181X__
        bool "milkv-duos"

endchoice
