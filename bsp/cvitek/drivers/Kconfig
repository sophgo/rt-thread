menu "Cvitek Drivers Configuration"

    config BSP_USING_DMA
        bool "Using DesignWare DMA"
        default y

    menuconfig BSP_USING_USB
        bool "Using USB"
        default y
        help
            Enable USB driver support for the platform.
            This will allow you to use USB devices in host or device mode.

        if BSP_USING_USB
            choice
                prompt "USB Framework Selection"
                help
                    Select the USB driver to be used. Only one can be selected.

                config BSP_USING_CHERRYUSB
                    bool "Using CherryUSB"
                    help
                        Select CherryUSB as the USB driver implementation.
                    rsource "usb/cherryusb/Kconfig"

                config BSP_USING_TEST
                    bool "Using TEST"
                    help
                        Select TEST as the USB driver implementation.
                    # rsource "usb/cherryusb/Kconfig"
            endchoice

        endif

    menuconfig BSP_USING_UART
        bool "Using UART"
        select RT_USING_SERIAL
        default y

        if BSP_USING_UART
            config BSP_USING_UART0
                bool "Enable UART 0"
                default y

            config BSP_USING_UART1
                bool "Enable UART 1"
                default y

            config BSP_USING_UART2
                bool "Enable UART 2"
                default n

            config BSP_USING_UART3
                bool "Enable UART 3"
                default n

            config BSP_USING_UART4
                bool "Enable UART 4"
                default n

            config BSP_UART_IRQ_BASE
                int
                default 44
        endif

