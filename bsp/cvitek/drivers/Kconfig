        select RT_USING_LWIP
        select RT_USING_POSIX_FS
        select RT_USING_POSIX_SOCKET

    config BSP_USING_TPU
        bool "Enable TPU"
        default y

    config BSP_USING_EFUSE
        bool "Using EFUSE API"
        default n

        if BSP_USING_EFUSE
            config BSP_USING_EFUSE_FASTBOOT
                bool "Provision FastBoot automatically on boot"
                default n
                help
                    Call efuse_fastboot() from the application after boot.

                    Provision the selected download sources as button/pin
                    driven FastBoot, or revert them to normal download.
                    Unselected sources are not modified. Sources already
                    in FastBoot or disabled mode are skipped when provisioning.
                    The explicit EnableFastBoot API still selects all sources;
                    The efuse tool queries by default and requires confirmation
                    for explicit enable/revert operations.

            if BSP_USING_EFUSE_FASTBOOT
                config BSP_EFUSE_FASTBOOT_UART
                    bool "Apply to UART download"
                    default y

                config BSP_EFUSE_FASTBOOT_SD
                    bool "Apply to SD download"
                    default y

                config BSP_EFUSE_FASTBOOT_USB
                    bool "Apply to USB download"
                    default y

                config BSP_EFUSE_FASTBOOT_REVERT
                    bool "Revert selected sources to normal download"
                    default n
                    help
                        Add the second OTP bit to change FastBoot (01) or
                        disabled (10) sources to normal download (11).
                        Sources in 00/11 are left untouched. CUSTOMER is
                        not modified. Once reverted to 11, the source
                        cannot be configured as FastBoot/disabled again.
            endif

            config CONFIG_BOOT_FREQ_HIGHER
                int "Program eFuse for a 750MHz CPU boot clock (irreversible), 1 = on"
                range 0 1
                default 0
                help
                    Burn eFuse Bonding0 bit11 on boot; the CPU boots at 750MHz
                    from the next power-on. OTP, cannot be reverted.
        endif

    config BSP_USING_SPACC
        bool "Using SPACC API"
        default n

    menuconfig BSP_USING_DRIVER_TOOL
        bool "ENABLE DRIVER_TOOLS"
        select RT_USING_DRIVER_TOOL
        default n

        if BSP_USING_DRIVER_TOOL
            config BSP_USING_EFUSE_TOOL
                bool "Enable eFUSE tool"
                depends on BSP_USING_EFUSE && FINSH_USING_MSH
                default n
                help
                    Provide efuse sn/dump/read/write/fastboot subcommands.
                    FastBoot queries by default; OTP writes require confirmation.

            config BSP_USING_WDT_TOOL
                bool "Enable Watchdog tool"
                depends on BSP_USING_WDT
                default n

            config BSP_USING_I2C_TOOL
                bool "Enable I2C_TOOL"
                default n

            config BSP_USING_PINMUX
                bool "Enable CVI_PINMUX"
                default n

            config BSP_USING_PERF_TOOL
                bool "Enable Real-time Performance Tool"
                default n
            
            config BSP_USING_NETUTILS
                bool "Enable NetUtils tools"
                default n
                select RT_USING_LWIP

                if BSP_USING_NETUTILS
                    config PKG_NETUTILS_IPERF
                        bool "Enable iperf"
                        default n

                    config PKG_NETUTILS_TELNET
                        bool "Enable telnet server"
                        default n
                endif
        endif

