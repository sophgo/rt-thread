from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')

chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []

if GetDepend('BSP_USING_I2C'):
    src += ['drv_hw_i2c.c']
    src += ['../../libraries/i2c/dw_iic.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root).
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_IIC'):
    src += ['test/i2c_test.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'i2c'),
    os.path.join(LIB_ROOT, 'pinctrl', 'chip', chip_type),
]

group = DefineGroup('drivers.i2c', src, depend = ['BSP_USING_I2C'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
