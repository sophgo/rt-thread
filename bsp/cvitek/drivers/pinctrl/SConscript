from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')
chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []
CPPPATH = []

if GetDepend('BSP_USING_DRV_PINMUX'):
    src += ['drv_pinmux.c']
    src += ['../../libraries/pinctrl/chip/' + chip_type + '/drv_pinmux_' + chip_type + '.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root). The test iterates the cvi_tool pin tables, which are
# split per chip directory.
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_PINMUX'):
    src += ['test/pinmux_test.c']
    CPPPATH += [
        driver_root + r'/../cvi_common/cvi_tool/cvi_pinmux/chip_' + chip_type,
    ]

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'pinctrl', 'chip', chip_type),
    cwd,
] + CPPPATH

group = DefineGroup('drivers.pinctrl', src, depend = [''], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
