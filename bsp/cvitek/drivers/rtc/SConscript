from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')

chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []

if GetDepend('BSP_USING_RTC'):
    src += ['drv_rtc.c']
    src += ['../../libraries/rtc/cvi_rtc.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root).
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_RTC'):
    src += ['test/rtc_test.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'rtc'),
    os.path.join(LIB_ROOT, 'pinctrl', 'chip', chip_type),
]

group = DefineGroup('drivers.rtc', src, depend = ['BSP_USING_RTC'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
