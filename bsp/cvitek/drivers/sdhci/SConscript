from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')

chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []

if GetDepend('BSP_USING_SDH'):
    src += ['drv_sdhci.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root).
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_SD'):
    src += ['test/sd_test.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'pinctrl', 'chip', chip_type),
    os.path.join(LIB_ROOT, 'sdif'),
]

group = DefineGroup('drivers.sdhci', src, depend = ['BSP_USING_SDH'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
