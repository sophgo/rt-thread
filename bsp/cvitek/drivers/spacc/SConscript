from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')

src = []

if GetDepend('BSP_USING_SPACC'):
    src += ['drv_spacc.c']
    src += ['../../libraries/spacc/cvi_spacc.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root).
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_SPACC'):
    src += ['test/spacc_test.c']
    src += ['test/spacc_dynm_test.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'spacc'),
]

group = DefineGroup('drivers.spacc', src, depend = ['BSP_USING_SPACC'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
