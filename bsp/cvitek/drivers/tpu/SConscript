from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')
chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []

if GetDepend('BSP_USING_TPU'):
    src += ['drv_tpu.c']
    src += ['../../libraries/tpu/common/cvi_tpu.c']
    # Per-chip TPU constants (TIU lane count etc.) selected at build time.
    src += ['../../libraries/tpu/chip/' + chip_type + '/cvi_tpu_chip.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root). Needs the TPU HAL headers from libraries/tpu/common.
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_TPU'):
    src += ['test/tpu_tdma_test.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'tpu', 'common'),
    os.path.join(LIB_ROOT, 'tpu', 'chip', chip_type),
]

group = DefineGroup('drivers.tpu', src, depend = ['BSP_USING_TPU'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
