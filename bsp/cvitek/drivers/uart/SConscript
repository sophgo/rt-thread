from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')

chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []

if GetDepend('BSP_USING_UART'):
    src += ['drv_uart.c']
    src += ['../../libraries/uart/dw_uart.c']

# Selftest moved from cvi_common/cvi_test (see README.selftest.md at the
# drivers/ root). random_data.h ships next to the test source.
if GetDepend('BSP_USING_SELFTEST') and GetDepend('BSP_TEST_UART'):
    src += ['test/uart_test.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'uart'),
    os.path.join(LIB_ROOT, 'pinctrl', 'chip', chip_type),
]

group = DefineGroup('drivers.uart', src, depend = ['BSP_USING_UART'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
