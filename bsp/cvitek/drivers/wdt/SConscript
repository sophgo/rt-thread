from building import *
import os

cwd = GetCurrentDir()
driver_root = os.path.dirname(cwd)
LIB_ROOT = os.path.join(driver_root, '..', 'libraries')

chip_type = 'cv180x'
if GetDepend('__CV181X__'):
    chip_type = 'cv181x'
elif GetDepend('__CV180X__'):
    chip_type = 'cv180x'

src = []

if GetDepend('BSP_USING_WDT'):
    src += ['drv_wdt.c']
    src += ['../../libraries/wdt/cvi_wdt.c']

CPPDEFINES = ['-DCONFIG_64BIT']
CPPPATH = [
    LIB_ROOT,
    os.path.join(LIB_ROOT, 'wdt'),
    os.path.join(LIB_ROOT, 'pinctrl', 'chip', chip_type),
]

group = DefineGroup('drivers.wdt', src, depend = ['BSP_USING_WDT'], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('group')
