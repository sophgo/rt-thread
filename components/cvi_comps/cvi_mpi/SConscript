import os
from building import *

cwd = GetCurrentDir()
objs = []
include = []
group = []

if GetDepend('CVI_MPI_ENABLE'):
    # Traverse all entries in the current directory
    for entry in os.listdir(cwd):
        entry_path = os.path.join(cwd, entry)
        # Check whther entry is directory
        if os.path.isdir(entry_path):
            # Check whether contain SConscript file
            sconscript = os.path.join(entry_path, 'SConscript')
            if os.path.isfile(sconscript):
                # Execute SConscript in subdirectory. Pass a RELATIVE path so
                # SCons keeps the variant_dir mapping and emits objects under
                # the build tree instead of in the source tree.
                objs.extend(SConscript(os.path.join(entry, 'SConscript')))
    include += [cwd + r'/include/']
    group = DefineGroup('cvi_mpi', objs, depend = [''], CPPPATH=include)
    
Return('group')