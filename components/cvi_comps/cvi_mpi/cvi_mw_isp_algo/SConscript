from building import *
import rtconfig

cwd = GetCurrentDir()
CPPPATH = [
    cwd + r'/include/',
]
group = DefineGroup('cvi_mw_isp_algo', [], depend = [''],
    CPPPATH = CPPPATH,
    LIBPATH = [cwd + r'/lib/' + rtconfig.SOC_SERIES_MAP[rtconfig.SOC_TYPE]],
    LIBS = ['isp_isp_algo'])
Return('group')
