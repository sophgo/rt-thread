import re
from building import *

cwd     = GetCurrentDir()
src     = []
CPPDEFINES = []
CPPPATH = []

#include
CPPPATH += [cwd + r'/include/']
CPPPATH += [cwd + r'/src/']
CPPPATH += [cwd + r'/../cvi_json_c/include/']
CPPPATH += [cwd + r'/../cvi_mw_isp_common/cvi_mw_isp_com_raw_replay/include/']

# src
src += Glob("src/*.c")

Import('SOC_TYPE')
# scons Execute() runs with the scons launch dir (solution root) as cwd, not
# this SConscript's dir, and prebuild.sh uses paths relative to its own dir
# (./src, ./../cvi_mw_isp_common/...). cd into `cwd` first so the script is
# found and its relative paths resolve correctly.
if re.search(r'cv180', SOC_TYPE, re.IGNORECASE):
    Execute('cd "{}" && bash prebuild.sh {}'.format(cwd, "cv180xx"))
elif re.search(r'cv181', SOC_TYPE, re.IGNORECASE):
    Execute('cd "{}" && bash prebuild.sh {}'.format(cwd, "cv181xx"))

cvi_mw_isp_daemon = DefineGroup('cvi_mw_isp_daemon', src, depend = [''], CPPDEFINES = CPPDEFINES, CPPPATH = CPPPATH)

Return('cvi_mw_isp_daemon')
